---
import { useTranslations } from '../i18n/ui';
import { formatDate, type PageRoute } from '../lib/site';
const { page } = Astro.props as { page: PageRoute };
const { lang } = page;
const path = (page.route || '').replace(/^en(?:\/|$)/, '');
const t = useTranslations(lang);

import Layout from '../layouts/Layout.astro';
import { getCollection } from '../lib/template';
import PublicationItem from '../components/PublicationItem.astro';
import BookItem from '../components/BookItem.astro';
import HonorCard from '../components/HonorCard.astro';
import { Book, ScrollText, Award, BookOpen, CheckCircle } from 'lucide-react';

// Fetch Collections
const papers = (await getCollection('publications', lang))
  .filter(p => p.data.type === 'paper')
  .sort((a, b) => b.data.year - a.data.year);
const books = (await getCollection('books', lang))
  .sort((a, b) => b.data.year - a.data.year);

const patents = (await getCollection('patents', lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const honors = (await getCollection('honors', lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sections = [
  { id: 'papers', title: 'Published Papers', key: 'achievements.papers', icon: BookOpen, count: papers.length },
  { id: 'books', title: 'Book Chapters', key: 'achievements.books', icon: Book, count: books.length },
  { id: 'patents', title: 'Invention Patents', key: 'achievements.patents', icon: ScrollText, count: patents.length },
  { id: 'honors', title: 'Group Honors', key: 'achievements.honors', icon: Award, count: honors.length },
].filter(section => !['books', 'honors'].includes(section.id) || section.count > 0);
---


<Layout title={t('achievements.title')} lang={lang} path={path}>
  <div class="max-w-7xl mx-auto px-4 py-12 sm:py-20">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-4" data-i18n-key="achievements.title">{t('achievements.title')}</h1>
      <p class="text-lg text-gray-600" data-i18n-key="achievements.subtitle">{t('achievements.subtitle')}</p>
    </div>

    <!-- Navigation Pills -->
    <div class="flex overflow-x-auto xl:justify-center gap-3 mb-16 sticky top-16 sm:top-20 z-30 bg-white/95 backdrop-blur p-3 sm:p-4 rounded-2xl border border-gray-100 shadow-sm">
      {sections.map(section => (
        <a 
          href={`#${section.id}`}
          class="inline-flex shrink-0 whitespace-nowrap items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition-colors text-sm font-medium"
        >
          <section.icon className="w-4 h-4" />
          <span data-i18n-key={section.key}>{t(section.key)}</span>
          <span class="bg-white px-2 py-0.5 rounded-full text-xs text-gray-400 shadow-sm">{section.count}</span>
        </a>
      ))}
    </div>

    <div class="space-y-24">
      <!-- Papers -->
      <section id="papers" class="scroll-mt-44">
        <div class="flex items-center gap-3 mb-8">
          <BookOpen className="w-8 h-8 text-blue-600" />
          <h2 class="text-3xl font-bold text-gray-900" data-i18n-key="achievements.papers">{t('achievements.papers')}</h2>
        </div>
        <div class="grid gap-6">
          {papers.map(paper => <PublicationItem entry={paper} lang={lang} />)}
          {papers.length === 0 && <p class="text-gray-500 italic" data-i18n-key="achievements.noPapers">{t('achievements.noPapers')}</p>}
        </div>
      </section>

      <!-- Books -->
      {books.length > 0 && <section id="books" class="scroll-mt-44">
        <div class="flex items-center gap-3 mb-8">
          <Book className="w-8 h-8 text-blue-600" />
          <h2 class="text-3xl font-bold text-gray-900" data-i18n-key="achievements.books">{t('achievements.books')}</h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {books.map(book => <BookItem entry={book} lang={lang} />)}
        </div>
      </section>}

      <!-- Patents -->
      <section id="patents" class="scroll-mt-44">
        <div class="flex items-center gap-3 mb-8">
          <ScrollText className="w-8 h-8 text-blue-600" />
          <h2 class="text-3xl font-bold text-gray-900" data-i18n-key="achievements.patents">{t('achievements.patents')}</h2>
        </div>
        <div class="grid gap-6">
          {patents.map(patent => (
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow" data-patent-id={patent.id} data-patent-status={patent.data.status}>
              <div class="flex gap-4">
                <div class="shrink-0">
                  <div class="p-3 bg-amber-50 text-amber-600 rounded-lg">
                    <ScrollText className="w-6 h-6" />
                  </div>
                </div>
                <div class="flex-grow min-w-0">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                    <h3 class="text-lg font-bold text-gray-900">{patent.data.title}</h3>
                    <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium border
                      ${patent.data.status === '维持' ? 'bg-green-50 text-green-700 border-green-200' :
                        'bg-gray-50 text-gray-600 border-gray-200'}`}>
                      {patent.data.status === '维持' && <CheckCircle className="w-3 h-3" />}
                      {patent.data.status === '维持' ? t('patent.status.maintained') : patent.data.status}
                    </span>
                  </div>
                  <div class="text-sm text-gray-600 mb-2">
                    <span class="font-medium text-gray-900" data-i18n-key="achievements.inventors">{t('achievements.inventors')}</span> {patent.data.inventors.join(', ')}
                  </div>
                  <p class="text-sm text-gray-600 mb-3"><span class="font-medium text-gray-900">{lang === 'zh' ? '专利权人／申请人：' : 'Holder / applicant: '}</span>{patent.data.holder}</p>
                  <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
                    <span class="font-mono bg-gray-50 px-2 py-0.5 rounded border border-gray-200">
                      {patent.data.number}
                    </span>
                    <span>{lang === 'zh' ? '申请日：' : 'Filed: '}<time datetime={patent.data.applicationDate}>{formatDate(patent.data.applicationDate, lang)}</time></span>
                    {patent.data.grantDate && <span>{lang === 'zh' ? '授权公告日：' : 'Grant publication: '}<time datetime={patent.data.grantDate}>{formatDate(patent.data.grantDate, lang)}</time></span>}
                    {patent.data.certificateUrl && <a href={patent.data.certificateUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline" data-patent-certificate>{lang === 'zh' ? '授权证书（PDF）' : 'Patent certificate (PDF)'}</a>}
                  </div>
                </div>
              </div>
            </div>
          ))}
           {patents.length === 0 && <p class="text-gray-500 italic" data-i18n-key="achievements.noPatents">{t('achievements.noPatents')}</p>}
        </div>
      </section>

      <!-- Honors -->
      {honors.length > 0 && <section id="honors" class="scroll-mt-44">
        <div class="flex items-center gap-3 mb-8">
          <Award className="w-8 h-8 text-blue-600" />
          <h2 class="text-3xl font-bold text-gray-900" data-i18n-key="achievements.honors">{t('achievements.honors')}</h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {honors.map(honor => <HonorCard honor={honor} />)}
        </div>
      </section>}

    </div>
  </div>
</Layout>

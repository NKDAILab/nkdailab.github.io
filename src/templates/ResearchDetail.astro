---
import { useTranslations } from '../i18n/ui';
import { localPath, type PageRoute } from '../lib/site';
const { page } = Astro.props as { page: PageRoute };
const { lang } = page;
const path = (page.route || '').replace(/^en(?:\/|$)/, '');
const t = useTranslations(lang);

import Layout from '../layouts/Layout.astro';
import { getCollection } from '../lib/template';


const area = (await getCollection('research', lang)).find(entry => entry.id === page.id)!;
---


<Layout title={area.data.title} lang={lang} path={path}>
  <article class="max-w-4xl mx-auto px-4 py-12 sm:py-20">
    <a href={localPath(lang, 'research')} class="inline-flex items-center text-sm text-gray-500 hover:text-blue-600 mb-8 transition-colors">
      &larr; {t('back.research')}
    </a>

    <header class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-6">{area.data.title}</h1>
      {area.data.cover && (
        <div class="w-full h-64 sm:h-96 rounded-2xl overflow-hidden bg-gray-100 mb-8">
          <img src={area.data.cover.src} alt={area.data.title} class="w-full h-full object-cover" />
        </div>
      )}
      {area.id !== 'areas' && <p class="text-xl text-gray-600 leading-relaxed">{area.data.description}</p>}
    </header>

    <div class="prose prose-lg prose-blue max-w-none text-gray-700">
      <Fragment set:html={area.body} />
    </div>
  </article>
</Layout>

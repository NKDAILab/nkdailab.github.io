---
import { useTranslations } from '../i18n/ui';
import { localPath, roleLabel, statusLabel, type PageRoute } from '../lib/site';
const { page } = Astro.props as { page: PageRoute };
const { lang } = page;
const path = (page.route || '').replace(/^en(?:\/|$)/, '');
const t = useTranslations(lang);

import Layout from '../layouts/Layout.astro';
import { getCollection } from '../lib/template';
import { Mail, Globe, Twitter, GraduationCap, ArrowLeft, Linkedin, Github } from 'lucide-react';


const member = (await getCollection('team', lang)).find(m => m.id === page.id)!;
const source = member.source;
const profile = source.profile[lang];
const { name, title, avatar, email, website, linkedin, github, twitter, googleScholar } = member.data;
---


<Layout title={name} lang={lang} path={path}>
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-20">
    <a href={localPath(lang, 'team')} class="inline-flex items-center text-sm text-gray-500 hover:text-blue-600 mb-8 transition-colors">
      <ArrowLeft className="w-4 h-4 mr-1" /> {t('back.team')}
    </a>

    <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm mb-12">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <div class="w-32 h-32 md:w-48 md:h-48 rounded-2xl overflow-hidden bg-gray-100 shrink-0 mx-auto md:mx-0">
          <img src={avatar.src} alt={name} class="w-full h-full object-cover" />
        </div>
        
        <div class="flex-grow text-center md:text-left">
          <h1 class="text-3xl font-bold text-gray-900 mb-2">{name}</h1>
          <p class="text-xl text-blue-600 font-medium mb-6">{roleLabel(source.role === 'alumni' ? source.previousRole : source.role, lang)}</p>
          
          <div class="flex flex-wrap justify-center md:justify-start gap-3">
            {email && (
              <a href={`mailto:${email}`} class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition-colors text-sm">
                <Mail className="w-4 h-4" />
                <span>{t('email')}</span>
              </a>
            )}
            {website && (
              <a href={website} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition-colors text-sm">
                <Globe className="w-4 h-4" />
                <span>{t('personalWebsite')}</span>
              </a>
            )}
            {linkedin && (
              <a href={linkedin} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition-colors text-sm">
                <Linkedin className="w-4 h-4" />
                <span>LinkedIn</span>
              </a>
            )}
            {github && (
              <a href={github} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition-colors text-sm">
                <Github className="w-4 h-4" />
                <span>GitHub</span>
              </a>
            )}
            {twitter && (
              <a href={twitter} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition-colors text-sm">
                <Twitter className="w-4 h-4" />
                <span>Twitter</span>
              </a>
            )}
            {googleScholar && (
              <a href={googleScholar} target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition-colors text-sm">
                <GraduationCap className="w-4 h-4" />
                <span>Scholar</span>
              </a>
            )}
          </div>

          {title && title.length > 0 && (
            <div class="flex flex-wrap justify-center md:justify-start gap-2 mt-4">
              {title.map((t) => (
                <span class="bg-blue-100 text-blue-800 text-xs px-2.5 py-0.5 rounded border border-blue-200">
                  {t}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    {source.role === 'alumni' && <aside id="destination" class="bg-blue-50 rounded-2xl p-6 border border-blue-100 mb-8">
      <h2 class="text-sm text-blue-700 font-medium mb-2">{t('member.destination')}</h2>
      {source.destination[lang] && <p class="text-xl font-semibold text-gray-900 mb-2">{source.destination[lang]}</p>}
      <p class="text-sm text-gray-600">{statusLabel(source.status, lang)}</p>
    </aside>}
    <div class="prose prose-lg prose-blue max-w-none text-gray-700">
      <Fragment set:html={profile.html} />
      {profile.interests.length > 0 && !/研究方向|Research Interests/i.test(profile.html) && <section><h2>{t('member.interests')}</h2><ul>{profile.interests.map(interest => <li>{interest}</li>)}</ul></section>}
      {profile.education.length > 0 && <section><h2>{t('member.education')}</h2><ul>{profile.education.map(education => <li><strong>{education.course}</strong><br />{education.institution}</li>)}</ul></section>}
    </div>
  </div>
</Layout>

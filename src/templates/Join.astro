---
import { useTranslations } from '../i18n/ui';
import type { PageRoute } from '../lib/site';
const { page } = Astro.props as { page: PageRoute };
const { lang } = page;
const path = (page.route || '').replace(/^en(?:\/|$)/, '');
const t = useTranslations(lang);

import Layout from '../layouts/Layout.astro';
import { GraduationCap, BookOpen, Code } from 'lucide-react';
import { SITE } from '../config';
import SendEmail from '../components/SendEmail.astro';
---


<Layout title={t('join.title')} lang={lang} path={path}>
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-4" data-i18n-key="join.title">{t('join.title')}</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto" data-i18n-key="join.subtitle">{t('join.subtitle')}</p>
    </div>

    <div class="grid gap-8 md:grid-cols-3 mb-16">
      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center mb-4 text-blue-600">
          <GraduationCap className="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">{lang === 'zh' ? '博士后' : 'Postdoctoral Researchers'}</h3>
        <p class="text-gray-600 text-sm mb-4">
          {lang === 'zh' ? '欢迎人工智能相关研究方向的博士后申请加入。' : 'Postdoctoral applicants working in the lab’s AI research areas are welcome.'}
        </p>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center mb-4 text-green-600">
          <BookOpen className="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">{lang === 'zh' ? '博士研究生' : 'PhD Students'}</h3>
        <p class="text-gray-600 text-sm mb-4">
          {lang === 'zh' ? '欢迎有志于科研的同学申请博士研究生，参与实验室研究。' : 'We welcome prospective PhD students interested in contributing to the lab’s research.'}
        </p>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center mb-4 text-purple-600">
          <Code className="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2" data-i18n-key="join.master">{t('join.master')}</h3>
        <p class="text-gray-600 text-sm mb-4">
          {t('join.masterDesc')}
        </p>
      </div>
    </div>

    <div class="bg-gray-50 rounded-3xl p-8 sm:p-12 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4" data-i18n-key="join.howToApply">{t('join.howToApply')}</h2>
      <p class="text-gray-600 mb-8 max-w-2xl mx-auto" data-i18n-key="join.applicationText">{t('join.applicationText')}</p>
      
      <SendEmail email={SITE.email} lang={lang} subject={t('join.applicationSubject')} />
    </div>
  </div>
</Layout>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { SITE } from '../config';
import '../styles/content.css';
import { localPath, type Lang } from '../lib/site';

interface Props {
  title?: string;
  lang?: Lang;
  path?: string;
  description?: string;
}

const { title, lang = 'zh', path = '', description = SITE.description[lang] } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.labName}` : `${SITE.labName} - ${SITE.university[lang]}`;

const ogImage = new URL(SITE.heroImage, SITE.website);
const canonical = new URL(localPath(lang, path), SITE.website);
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self';" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={SITE.logo} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(localPath('zh', path), SITE.website)} />
    <link rel="alternate" hreflang="en" href={new URL(localPath('en', path), SITE.website)} />
    <link rel="alternate" type="application/rss+xml" title={SITE.shortName} href={localPath(lang) + 'index.xml'} />
    <meta name="generator" content={Astro.generator} />
    
    <title>{pageTitle}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    {
      Astro.url.pathname === '/' && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "ResearchOrganization",
          "name": SITE.name[lang],
          "url": SITE.website,
          "image": new URL(SITE.logo, SITE.website).href,
          
          "worksFor": {
            "@type": "Organization",
            "name": SITE.labName,
            "url": SITE.website
          },
          "description": SITE.description[lang]
        })} />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <Header lang={lang} path={path} />
    <main id="main-content" class="flex-grow" data-pagefind-body>
      <slot />
    </main>
    
    <footer data-pagefind-ignore class="border-t border-gray-100 py-8 mt-12 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 text-center text-gray-500 text-sm">
        <p>
          <a href="https://github.com/fjd2004711/scholar-lite" target="_blank" class="hover:text-gray-700 inline-flex items-center gap-1 transition-colors">
            Built with Scholar-Lite Open Source Template
          </a>
        </p>
      </div>
    </footer>


  </body>
</html>

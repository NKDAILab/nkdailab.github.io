---
import { Image } from 'astro:assets';
import { galleryEntries } from '../lib/template';
import type { Lang } from '../lib/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const photos = galleryEntries(lang);
---

<div class={photos.length < 2 ? 'max-w-4xl mx-auto' : 'grid gap-8 md:grid-cols-2'}>
  {photos.map(photo => <figure class="rounded-2xl overflow-hidden border border-gray-100 bg-white shadow-sm" data-gallery-photo={photo.id}>
    <a href={photo.original} target="_blank" rel="noopener noreferrer" aria-label={photo.caption}>
      <Image src={photo.image} alt={photo.caption} class="w-full h-auto" widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 900px" quality={80} format="webp" />
    </a>
    <figcaption class="p-5 text-sm text-gray-600">{photo.caption}</figcaption>
  </figure>)}
</div>

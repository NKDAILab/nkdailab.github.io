---
import { Globe, Twitter, GraduationCap, User } from 'lucide-react';
import SendEmail from './SendEmail.astro';
import type { TeamEntry } from '../lib/template';
import { localPath, type Lang } from '../lib/site';

interface Props {
  member: TeamEntry;
  lang: Lang;
}

const { member, lang } = Astro.props;
const { name, avatar, bio, email, website, linkedin, github, twitter, googleScholar } = member.data;

// Color mapping for title badges
const badgeColors = [
  "text-blue-700 bg-blue-50 border-blue-100",
  "text-purple-700 bg-purple-50 border-purple-100",
  "text-emerald-700 bg-emerald-50 border-emerald-100",
  "text-amber-700 bg-amber-50 border-amber-100",
  "text-rose-700 bg-rose-50 border-rose-100"
];
---

<div class="group flex flex-col items-center text-center" data-member-id={member.id} data-member-role={member.source.role} data-email-group>
  <!-- Avatar Container -->
  <div class="relative w-48 h-48 mb-4 rounded-xl overflow-hidden bg-gray-100 group-hover:shadow-lg transition-shadow">
    <a href={localPath(lang, 'team/' + (member.id))} class="block w-full h-full">
      {avatar.src ? <img
        src={avatar.src} 
        alt={name} 
        class:list={['w-full h-full', avatar.fit === 'contain' ? 'object-contain bg-white' : 'object-cover object-top']}
        loading="lazy"
      /> : <div class="w-full h-full flex items-center justify-center text-gray-400" role="img" aria-label={lang === 'zh' ? `${name}，照片待补充` : `${name}, photo to be added`}><User className="w-20 h-20" /></div>}
    </a>
    
    <!-- Social Overlay (appears on hover) -->
    <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3 backdrop-blur-[2px] pointer-events-none">
      <div class="pointer-events-auto flex flex-wrap justify-center gap-2 px-2">
      {email && (
        <SendEmail email={email} lang={lang} variant="icon" inlineFeedback={false} ariaLabel={`${lang === 'zh' ? '发送邮件给' : 'Email'} ${name}`} />
      )}
      {website && (
        <a href={website} target="_blank" class="p-2 bg-white rounded-full text-gray-700 hover:text-blue-600 hover:scale-110 transition-all" title="Website" aria-label="Website">
          <Globe className="w-4 h-4" />
        </a>
      )}
      {linkedin && (
        <a href={linkedin} target="_blank" class="p-2 bg-white rounded-full text-gray-700 hover:text-blue-600 hover:scale-110 transition-all" title="LinkedIn" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
      )}
      {github && (
        <a href={github} target="_blank" class="p-2 bg-white rounded-full text-gray-700 hover:text-blue-600 hover:scale-110 transition-all" title="GitHub" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </a>
      )}
      {twitter && (
        <a href={twitter} target="_blank" class="p-2 bg-white rounded-full text-gray-700 hover:text-blue-400 hover:scale-110 transition-all" title="Twitter" aria-label="Twitter">
          <Twitter className="w-4 h-4" />
        </a>
      )}
      {googleScholar && (
        <a href={googleScholar} target="_blank" class="p-2 bg-white rounded-full text-gray-700 hover:text-blue-600 hover:scale-110 transition-all" title={`Scholar: ${member.source.name.en}`} aria-label={`Scholar: ${member.source.name.en}`}>
          <GraduationCap className="w-4 h-4" />
        </a>
      )}
      </div>
    </div>
  </div>

  <!-- Info -->
  <a href={localPath(lang, 'team/' + (member.id))} class="hover:underline decoration-blue-600 underline-offset-2 mb-2">
    <h3 class="text-lg font-semibold text-gray-900">{name}</h3>
  </a>
  
  {member.data.title && member.data.title.length > 0 && (
    <div class="flex flex-wrap justify-center gap-2 mb-3 px-2">
      {member.data.title.map((t, index) => (
        <span class={`inline-block px-2 py-0.5 text-xs font-medium border rounded-full ${badgeColors[index % badgeColors.length]}`}>
          {t}
        </span>
      ))}
    </div>
  )}
  
  {/* Role display removed as per request, relying on section headers and title badges */}
  
  {bio && <p class="text-sm text-gray-500 px-2" data-member-note>{member.source.role === 'alumni' && <span>{lang === 'zh' ? '毕业去向：' : 'Destination: '}</span>}{bio}</p>}
  {email && <SendEmail email={email} lang={lang} variant="text" label={email} ariaLabel={`${lang === 'zh' ? '发送邮件给' : 'Email'} ${name}`} />}
</div>
